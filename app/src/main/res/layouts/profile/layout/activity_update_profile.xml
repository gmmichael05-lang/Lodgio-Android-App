<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lodgio_bg">

    <!-- ═══ Premium Toolbar ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@drawable/bg_gradient_primary"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_base"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:padding="@dimen/spacing_xs" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Update Profile"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/spacing_md" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_base">

            <!-- Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl"
                android:elevation="@dimen/elevation_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Update Profile"
                    android:textSize="@dimen/text_headline"
                    android:textStyle="bold"
                    android:textColor="@color/lodgio_text_primary"
                    android:letterSpacing="-0.02"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modify your personal information"
                    android:textColor="@color/lodgio_text_secondary"
                    android:textSize="@dimen/text_body_sm"
                    android:layout_marginBottom="@dimen/spacing_xl" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textColor="@color/lodgio_text_primary"
                    android:textSize="@dimen/text_body_sm"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:background="@drawable/input_background"
                    android:hint="Enter new full name"
                    android:textColorHint="@color/lodgio_text_hint"
                    android:textColor="@color/lodgio_text_primary"
                    android:textSize="@dimen/text_body"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    android:layout_marginBottom="@dimen/spacing_base" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile Number"
                    android:textColor="@color/lodgio_text_primary"
                    android:textSize="@dimen/text_body_sm"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <EditText
                    android:id="@+id/etMobile"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:background="@drawable/input_background"
                    android:hint="Enter new mobile number"
                    android:textColorHint="@color/lodgio_text_hint"
                    android:textColor="@color/lodgio_text_primary"
                    android:textSize="@dimen/text_body"
                    android:inputType="phone"
                    android:singleLine="true"
                    android:layout_marginBottom="@dimen/spacing_xl" />

                <Button
                    android:id="@+id/btnUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:background="@drawable/btn_primary_bg"
                    android:text="Save Changes"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_subtitle"
                    android:textAllCaps="false"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/spacing_base" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
