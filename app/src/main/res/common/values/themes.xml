<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.TestApplication" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lodgio_primary</item>
        <item name="colorPrimaryDark">@color/lodgio_primary_dark</item>
        <item name="colorAccent">@color/lodgio_accent</item>
        <item name="android:windowBackground">@color/lodgio_bg</item>
        <item name="android:statusBarColor">@color/lodgio_primary_dark</item>
        <item name="android:navigationBarColor">@color/lodgio_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.TestApplication" parent="Base.Theme.TestApplication" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- Lodgio Premium Style System                 -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Primary Button -->
    <style name="LodgioButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Outlined Button -->
    <style name="LodgioButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/lodgio_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/lodgio_primary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- Card style -->
    <style name="LodgioCard">
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">@dimen/spacing_xl</item>
    </style>

    <!-- Input TextInputLayout -->
    <style name="LodgioInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/lodgio_input_stroke</item>
        <item name="hintTextColor">@color/lodgio_text_hint</item>
    </style>

    <!-- Section Header Text -->
    <style name="LodgioSectionHeader">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lodgio_text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Toolbar -->
    <style name="LodgioToolbar">
        <item name="android:background">@drawable/bg_gradient_primary</item>
        <item name="android:minHeight">@dimen/toolbar_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/spacing_base</item>
        <item name="android:paddingEnd">@dimen/spacing_base</item>
    </style>

    <!-- ShapeableImageView Styles -->
    <style name="RoundedCornerImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>