<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lodgio_bg">

    <!-- ═══ Premium Toolbar ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@drawable/bg_gradient_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_base"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Admin Dashboard"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_danger_bg"
            android:text="Logout"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:paddingHorizontal="@dimen/spacing_base" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/spacing_lg"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_base">

            <TextView
                android:id="@+id/tvAdminName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body"
                android:textColor="@color/lodgio_text_secondary"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- ═══ Stats Grid (2x2) ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_lg">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_sm">

                    <!-- Total Users -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="@dimen/spacing_lg"
                        android:elevation="@dimen/elevation_sm"
                        android:layout_marginEnd="@dimen/spacing_xs">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👥"
                            android:textSize="20sp"
                            android:layout_marginBottom="@dimen/spacing_xs" />
                        <TextView
                            android:id="@+id/tvStatUsers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/lodgio_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Users"
                            android:textSize="11sp"
                            android:textColor="@color/lodgio_text_hint" />
                    </LinearLayout>

                    <!-- Guests -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="@dimen/spacing_lg"
                        android:elevation="@dimen/elevation_sm"
                        android:layout_marginStart="@dimen/spacing_xs">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏡"
                            android:textSize="20sp"
                            android:layout_marginBottom="@dimen/spacing_xs" />
                        <TextView
                            android:id="@+id/tvStatGuests"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/lodgio_success" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Guests"
                            android:textSize="11sp"
                            android:textColor="@color/lodgio_text_hint" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Hosts -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="@dimen/spacing_lg"
                        android:elevation="@dimen/elevation_sm"
                        android:layout_marginEnd="@dimen/spacing_xs">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏠"
                            android:textSize="20sp"
                            android:layout_marginBottom="@dimen/spacing_xs" />
                        <TextView
                            android:id="@+id/tvStatHosts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/lodgio_admin_badge" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hosts"
                            android:textSize="11sp"
                            android:textColor="@color/lodgio_text_hint" />
                    </LinearLayout>

                    <!-- Listings -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="@dimen/spacing_lg"
                        android:elevation="@dimen/elevation_sm"
                        android:layout_marginStart="@dimen/spacing_xs">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋"
                            android:textSize="20sp"
                            android:layout_marginBottom="@dimen/spacing_xs" />
                        <TextView
                            android:id="@+id/tvStatListings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/lodgio_accent" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Listings"
                            android:textSize="11sp"
                            android:textColor="@color/lodgio_text_hint" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Users Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_md"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="All Users"
                    style="@style/LodgioSectionHeader" />

                <TextView
                    android:id="@+id/tvUserCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_admin"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="3dp"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    android:textColor="@color/lodgio_admin_badge" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llUsers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_xl" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lodgio_divider"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- Listings Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_md"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="All Listings"
                    style="@style/LodgioSectionHeader" />

                <TextView
                    android:id="@+id/tvListingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_admin"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="3dp"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    android:textColor="@color/lodgio_admin_badge" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llAdminListings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
