<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_sm"
    android:layout_marginVertical="@dimen/spacing_xs"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_base"
        android:gravity="center_vertical">

    <!-- Property Icon -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivListingImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_property"
            android:background="@color/lodgio_bg_surface"
            app:shapeAppearanceOverlay="@style/RoundedCornerImage"
            android:scaleType="centerCrop"
            android:contentDescription="Listing" />

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_md">

        <TextView
            android:id="@+id/tvListingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:textColor="@color/lodgio_text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvListingType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body_sm"
            android:textColor="@color/lodgio_text_secondary"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvListingPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:textColor="@color/lodgio_primary"
            android:layout_marginTop="@dimen/spacing_xs" />
    </LinearLayout>

    <!-- Active Toggle -->
    <Switch
        android:id="@+id/swListingActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_sm" />

        <!-- Delete Button -->
        <ImageView
            android:id="@+id/btnDeleteListing"
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:src="@drawable/ic_delete"
            android:contentDescription="Delete"
            android:padding="@dimen/spacing_xs" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
