<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lodgio_bg">

    <!-- ═══ Premium Toolbar ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@drawable/bg_gradient_primary"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_base"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:padding="@dimen/spacing_xs" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Create Listing"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/spacing_md" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_base">

            <!-- Property Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property Title"
                android:textStyle="bold"
                android:textSize="@dimen/text_body_sm"
                android:textColor="@color/lodgio_text_primary"
                android:layout_marginBottom="@dimen/spacing_sm" />
            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background"
                android:hint="e.g. Modern Apartment in Makati"
                android:textColorHint="@color/lodgio_text_hint"
                android:textColor="@color/lodgio_text_primary"
                android:singleLine="true"
                android:textSize="14sp"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- City -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="City"
                android:textStyle="bold"
                android:textSize="@dimen/text_body_sm"
                android:textColor="@color/lodgio_text_primary"
                android:layout_marginBottom="@dimen/spacing_sm" />
            <EditText
                android:id="@+id/etCity"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background"
                android:hint="e.g. Makati"
                android:textColorHint="@color/lodgio_text_hint"
                android:textColor="@color/lodgio_text_primary"
                android:singleLine="true"
                android:textSize="14sp"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Property Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property Type"
                android:textStyle="bold"
                android:textSize="@dimen/text_body_sm"
                android:textColor="@color/lodgio_text_primary"
                android:layout_marginBottom="@dimen/spacing_sm" />
            <Spinner
                android:id="@+id/spType"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textStyle="bold"
                android:textSize="@dimen/text_body_sm"
                android:textColor="@color/lodgio_text_primary"
                android:layout_marginBottom="@dimen/spacing_sm" />
            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/input_background"
                android:hint="Describe your property..."
                android:textColorHint="@color/lodgio_text_hint"
                android:textColor="@color/lodgio_text_primary"
                android:gravity="top"
                android:textSize="14sp"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Price & Guests Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_sm">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Price/Night (₱)" android:textStyle="bold" android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/lodgio_text_primary" android:layout_marginBottom="@dimen/spacing_sm" />
                    <EditText android:id="@+id/etPrice" android:layout_width="match_parent" android:layout_height="@dimen/input_height"
                        android:background="@drawable/input_background" android:hint="5000"
                        android:textColorHint="@color/lodgio_text_hint" android:textColor="@color/lodgio_text_primary"
                        android:inputType="numberDecimal" android:singleLine="true" android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_sm">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Max Guests" android:textStyle="bold" android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/lodgio_text_primary" android:layout_marginBottom="@dimen/spacing_sm" />
                    <EditText android:id="@+id/etGuests" android:layout_width="match_parent" android:layout_height="@dimen/input_height"
                        android:background="@drawable/input_background" android:hint="4"
                        android:textColorHint="@color/lodgio_text_hint" android:textColor="@color/lodgio_text_primary"
                        android:inputType="number" android:singleLine="true" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Beds & Baths Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="@dimen/spacing_sm">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Beds" android:textStyle="bold" android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/lodgio_text_primary" android:layout_marginBottom="@dimen/spacing_sm" />
                    <EditText android:id="@+id/etBeds" android:layout_width="match_parent" android:layout_height="@dimen/input_height"
                        android:background="@drawable/input_background" android:hint="2"
                        android:textColorHint="@color/lodgio_text_hint" android:textColor="@color/lodgio_text_primary"
                        android:inputType="number" android:singleLine="true" android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_sm">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Baths" android:textStyle="bold" android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/lodgio_text_primary" android:layout_marginBottom="@dimen/spacing_sm" />
                    <EditText android:id="@+id/etBaths" android:layout_width="match_parent" android:layout_height="@dimen/input_height"
                        android:background="@drawable/input_background" android:hint="1"
                        android:textColorHint="@color/lodgio_text_hint" android:textColor="@color/lodgio_text_primary"
                        android:inputType="number" android:singleLine="true" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Image URLs -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Image URLs (comma separated)" android:textStyle="bold"
                android:textSize="@dimen/text_body_sm" android:textColor="@color/lodgio_text_primary"
                android:layout_marginBottom="@dimen/spacing_sm" />
            <EditText android:id="@+id/etImageUrls" android:layout_width="match_parent" android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background" android:hint="https://..."
                android:textColorHint="@color/lodgio_text_hint" android:textColor="@color/lodgio_text_primary"
                android:singleLine="true" android:textSize="14sp" android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Amenities -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Amenities (comma separated)" android:textStyle="bold"
                android:textSize="@dimen/text_body_sm" android:textColor="@color/lodgio_text_primary"
                android:layout_marginBottom="@dimen/spacing_sm" />
            <EditText android:id="@+id/etAmenities" android:layout_width="match_parent" android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background" android:hint="WiFi, Pool, Parking..."
                android:textColorHint="@color/lodgio_text_hint" android:textColor="@color/lodgio_text_primary"
                android:singleLine="true" android:textSize="14sp" android:layout_marginBottom="@dimen/spacing_xl" />

            <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:visibility="gone" android:layout_marginBottom="@dimen/spacing_sm" />

            <Button
                android:id="@+id/btnPublish"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:background="@drawable/btn_primary_bg"
                android:text="Publish Listing"
                android:textColor="@color/white"
                android:textSize="@dimen/text_subtitle"
                android:textAllCaps="false"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
