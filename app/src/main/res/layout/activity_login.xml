<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/lodgio_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ Hero Section ═══ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_dark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="bottom"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_4xl">

                <!-- Logo Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_primary_bg"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:layout_marginBottom="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LODGIO"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome\nback"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp"
                    android:letterSpacing="-0.02"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in to access your bookings and manage your listings."
                    android:textColor="@color/lodgio_text_on_dark"
                    android:textSize="@dimen/text_body_sm"
                    android:lineSpacingExtra="3dp"
                    android:alpha="0.8" />
            </LinearLayout>
        </FrameLayout>

        <!-- ═══ Sign In Card ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingTop="@dimen/spacing_2xl"
            android:paddingBottom="@dimen/spacing_xl"
            android:layout_marginTop="-24dp"
            android:elevation="@dimen/elevation_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your credentials to continue"
                android:textColor="@color/lodgio_text_secondary"
                android:textSize="@dimen/text_body_sm"
                android:layout_marginBottom="@dimen/spacing_xl" />

            <!-- Email Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background"
                android:hint="you@example.com"
                android:textColorHint="@color/lodgio_text_hint"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:layout_marginBottom="@dimen/spacing_base" />

            <!-- Password Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background"
                android:hint="Enter your password"
                android:textColorHint="@color/lodgio_text_hint"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body"
                android:inputType="textPassword"
                android:singleLine="true"
                android:layout_marginBottom="@dimen/spacing_xl" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:background="@drawable/btn_primary_bg"
                android:text="Continue"
                android:textColor="@color/white"
                android:textSize="@dimen/text_subtitle"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginBottom="@dimen/spacing_base" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lodgio_divider"
                android:layout_marginVertical="@dimen/spacing_base" />

            <TextView
                android:id="@+id/btnGoToRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Don't have an account? Sign up"
                android:textColor="@color/lodgio_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
