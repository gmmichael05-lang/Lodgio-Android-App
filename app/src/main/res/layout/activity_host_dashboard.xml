<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lodgio_bg">

    <!-- ═══ Premium Toolbar ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@drawable/bg_gradient_primary"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_base"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Host Dashboard"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <ImageView
            android:id="@+id/btnProfile"
            android:layout_width="@dimen/avatar_sm"
            android:layout_height="@dimen/avatar_sm"
            android:src="@drawable/ic_profile"
            android:background="@drawable/avatar_circle"
            android:contentDescription="Profile"
            android:padding="6dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_base">

            <!-- Welcome -->
            <TextView
                android:id="@+id/tvWelcomeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back, Host!"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                android:textColor="@color/lodgio_text_primary"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage your listings and bookings"
                android:textSize="@dimen/text_body_sm"
                android:textColor="@color/lodgio_text_secondary"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Create Listing Button -->
            <Button
                android:id="@+id/btnCreateListing"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:background="@drawable/btn_primary_bg"
                android:text="＋ Create New Listing"
                android:textColor="@color/white"
                android:textSize="@dimen/text_subtitle"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginBottom="@dimen/spacing_xl" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lodgio_divider"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- Booking Requests -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booking Requests"
                style="@style/LodgioSectionHeader"
                android:layout_marginBottom="@dimen/spacing_md" />

            <LinearLayout
                android:id="@+id/llBookingRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_xl" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lodgio_divider"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- My Listings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Listings"
                style="@style/LodgioSectionHeader"
                android:layout_marginBottom="@dimen/spacing_md" />

            <LinearLayout
                android:id="@+id/llMyListings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
