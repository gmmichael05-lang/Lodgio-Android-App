<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/lodgio_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ Hero Section ═══ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_dark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="bottom"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_4xl">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_primary_bg"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:layout_marginBottom="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LODGIO"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Join Lodgio"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create an account to unlock exclusive stays or list your property."
                    android:textColor="@color/lodgio_text_on_dark"
                    android:textSize="@dimen/text_body_sm"
                    android:lineSpacingExtra="3dp"
                    android:alpha="0.8" />
            </LinearLayout>
        </FrameLayout>

        <!-- ═══ Register Card ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingTop="@dimen/spacing_2xl"
            android:paddingBottom="@dimen/spacing_xl"
            android:layout_marginTop="-24dp"
            android:elevation="@dimen/elevation_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                android:textColor="@color/lodgio_text_primary"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start your journey today."
                android:textColor="@color/lodgio_text_secondary"
                android:textSize="@dimen/text_body_sm"
                android:layout_marginBottom="@dimen/spacing_xl" />

            <!-- Role Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I want to..."
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/search_bar_bg"
                android:padding="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_lg">
                <RadioButton
                    android:id="@+id/rbGuest"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="🏡 Guest"
                    android:textSize="14sp"
                    android:checked="true"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/role_selector_bg"
                    android:textColor="@color/lodgio_text_primary"
                    android:layout_marginEnd="@dimen/spacing_xs" />
                <RadioButton
                    android:id="@+id/rbHost"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="🏠 Host"
                    android:textSize="14sp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/role_selector_bg"
                    android:textColor="@color/lodgio_text_primary"
                    android:layout_marginStart="@dimen/spacing_xs" />
            </RadioGroup>

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background"
                android:hint="ex. Juan Dela Cruz"
                android:textColorHint="@color/lodgio_text_hint"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:layout_marginBottom="@dimen/spacing_base" />

            <!-- Mobile -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile Number"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <EditText
                android:id="@+id/etMobile"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background"
                android:hint="0912 345 6789"
                android:textColorHint="@color/lodgio_text_hint"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body"
                android:inputType="phone"
                android:singleLine="true"
                android:layout_marginBottom="@dimen/spacing_base" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background"
                android:hint="you@example.com"
                android:textColorHint="@color/lodgio_text_hint"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:layout_marginBottom="@dimen/spacing_base" />

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background"
                android:hint="Create a password"
                android:textColorHint="@color/lodgio_text_hint"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body"
                android:inputType="textPassword"
                android:singleLine="true"
                android:layout_marginBottom="@dimen/spacing_base" />

            <!-- Confirm Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <EditText
                android:id="@+id/etPasswordConfirm"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:background="@drawable/input_background"
                android:hint="Re-enter password"
                android:textColorHint="@color/lodgio_text_hint"
                android:textColor="@color/lodgio_text_primary"
                android:textSize="@dimen/text_body"
                android:inputType="textPassword"
                android:singleLine="true"
                android:layout_marginBottom="@dimen/spacing_xl" />

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:background="@drawable/btn_primary_bg"
                android:text="Create Account"
                android:textColor="@color/white"
                android:textSize="@dimen/text_subtitle"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginBottom="@dimen/spacing_base" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lodgio_divider"
                android:layout_marginVertical="@dimen/spacing_base" />

            <TextView
                android:id="@+id/btnGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Already have an account? Login"
                android:textColor="@color/lodgio_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="@dimen/spacing_sm"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
