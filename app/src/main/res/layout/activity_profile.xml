<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lodgio_bg">

    <!-- ═══ Premium Toolbar ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@drawable/bg_gradient_primary"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_base"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:padding="@dimen/spacing_xs" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Profile"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/spacing_md" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginTop="@dimen/spacing_2xl" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_base">

            <!-- ═══ Avatar Card ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/card_background"
                android:padding="@dimen/spacing_2xl"
                android:elevation="@dimen/elevation_md"
                android:layout_marginBottom="@dimen/spacing_base">

                <TextView
                    android:id="@+id/tvAvatarInitial"
                    android:layout_width="@dimen/avatar_xl"
                    android:layout_height="@dimen/avatar_xl"
                    android:background="@drawable/avatar_circle"
                    android:gravity="center"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="@dimen/spacing_base" />

                <TextView
                    android:id="@+id/tvNameInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    android:textColor="@color/lodgio_text_primary"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/tvEmailInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body_sm"
                    android:textColor="@color/lodgio_text_secondary"
                    android:layout_marginBottom="@dimen/spacing_md" />

                <TextView
                    android:id="@+id/tvRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_guest"
                    android:paddingHorizontal="@dimen/spacing_base"
                    android:paddingVertical="@dimen/spacing_xs"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/lodgio_guest_badge" />
            </LinearLayout>

            <!-- ═══ Contact Info Card ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="@dimen/spacing_lg"
                android:elevation="@dimen/elevation_sm"
                android:layout_marginBottom="@dimen/spacing_base">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Information"
                    style="@style/LodgioSectionHeader"
                    android:layout_marginBottom="@dimen/spacing_base" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/lodgio_divider"
                    android:layout_marginBottom="@dimen/spacing_base" />

                <!-- Email row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/lodgio_text_hint" />

                    <TextView
                        android:id="@+id/tvEmailDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_body_sm"
                        android:textStyle="bold"
                        android:textColor="@color/lodgio_text_primary" />
                </LinearLayout>

                <!-- Mobile row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Mobile"
                        android:textSize="@dimen/text_body_sm"
                        android:textColor="@color/lodgio_text_hint" />

                    <TextView
                        android:id="@+id/tvMobileInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_body_sm"
                        android:textStyle="bold"
                        android:textColor="@color/lodgio_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Action Buttons ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="@dimen/spacing_lg"
                android:elevation="@dimen/elevation_sm"
                android:layout_marginBottom="@dimen/spacing_base">

                <Button
                    android:id="@+id/btnUpdateProfile"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:background="@drawable/btn_primary_bg"
                    android:text="Edit Profile"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_subtitle"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <Button
                    android:id="@+id/btnChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:background="@drawable/btn_outlined_bg"
                    android:text="Change Password"
                    android:textColor="@color/lodgio_primary"
                    android:textSize="@dimen/text_subtitle"
                    android:textAllCaps="false"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Logout -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:background="@drawable/btn_danger_bg"
                android:text="Logout"
                android:textColor="@color/white"
                android:textSize="@dimen/text_subtitle"
                android:textAllCaps="false"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
